<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTML Testing Page</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <header>
        <h1>HTML Testing Page</h1>
        <p>This page contains common HTML elements for testing.</p>
    </header>

    <hr>

    <section>
        <h2>Text Elements</h2>
        <p>This is a paragraph.</p>
        <strong>Strong Text</strong><br>
        <em>Italic Text</em><br>
        <mark>Highlighted Text</mark><br>
        <small>Small Text</small>
    </section>

    <hr>

    <section>
        <h2>Links</h2>
        <a href="https://www.google.com" target="_blank">Open Google</a>
    </section>

    <hr>

    <section>
        <h2>Lists</h2>

        <h3>Ordered List</h3>
        <ol>
            <li>HTML</li>
            <li>CSS</li>
            <li>JavaScript</li>
        </ol>

        <h3>Unordered List</h3>
        <ul>
            <li>Apple</li>
            <li>Banana</li>
            <li>Orange</li>
        </ul>
    </section>

    <hr>

    <section>
        <h2>Image</h2>
        <img src="https://via.placeholder.com/300" alt="Sample Image">
    </section>

    <hr>

    <section>
        <h2>Table</h2>

        <table border="1">
            <tr>
                <th>Name</th>
                <th>Age</th>
            </tr>
            <tr>
                <td>Shiva</td>
                <td>22</td>
            </tr>
            <tr>
                <td>John</td>
                <td>25</td>
            </tr>
        </table>
    </section>

    <hr>

    <section>
        <h2>Form Elements</h2>

        <form>
            <label>Name:</label><br>
            <input type="text" placeholder="Enter name"><br><br>

            <label>Email:</label><br>
            <input type="email" placeholder="Enter email"><br><br>

            <label>Password:</label><br>
            <input type="password"><br><br>

            <label>Date:</label><br>
            <input type="date"><br><br>

            <label>Gender:</label><br>
            <input type="radio" name="gender"> Male
            <input type="radio" name="gender"> Female
            <br><br>

            <label>Skills:</label><br>
            <input type="checkbox"> HTML
            <input type="checkbox"> CSS
            <input type="checkbox"> JS
            <br><br>

            <label>Country:</label><br>
            <select>
                <option>India</option>
                <option>USA</option>
                <option>UK</option>
            </select>
            <br><br>

            <label>Comments:</label><br>
            <textarea rows="4" cols="40"></textarea>
            <br><br>

            <button type="submit">Submit</button>
        </form>
    </section>

    <hr>

    <section>
        <h2>Audio & Video</h2>

        <audio controls>
            <source src="" type="audio/mpeg">
        </audio>

        <br><br>

        <video width="300" controls>
            <source src="" type="video/mp4">
        </video>
    </section>

    <hr>

    <section>
        <h2>Button for JavaScript Testing</h2>
        <button id="testBtn">Click Me</button>
        <p id="output"></p>
    </section>

    <!-- External JavaScript -->
    <script src="js/script.js"></script>

</body>
</html>